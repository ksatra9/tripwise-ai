# TripWise AI - Environment Configuration

# Optional Google Gemini API Key for NLP extraction & conversational summary.
# If omitted or call fails, the system automatically runs on deterministic local fallback!
GEMINI_API_KEY=

# Supported Gemini Model ID. Verified options: gemini-2.5-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# SQLite Database Location
DATABASE_URL=sqlite:///./travel_app.db

# Server port and environment
PORT=8000
ENVIRONMENT=development
# JSON array. Set production frontend origin(s); never use * with credentials.
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
